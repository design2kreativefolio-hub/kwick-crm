# ============================================================
# Kwick Internal Platform — root environment (docker-compose)
# Copy to .env and fill in real values before deploying.
# Target host: OVH Cloud VPS-1, Ubuntu 22.04, 2 vCores / 4 GB RAM.
# ============================================================

# ---- Domains (placeholders — swap once DNS is ready) ----
FRONTEND_DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com

# ---- Django ----
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# Comma-separated origins allowed to call the API from the browser
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
# Used to build links embedded in emails (e.g. employee set-password link)
FRONTEND_URL=https://yourdomain.com

# ---- PostgreSQL (tuned: shared_buffers ~256MB, max_connections ~50) ----
POSTGRES_DB=kwick
POSTGRES_USER=kwick
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis (maxmemory 256MB, allkeys-lru — Channels layer + Celery broker) ----
REDIS_URL=redis://redis:6379/0

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# concurrency matches 2 vCores
CELERY_WORKER_CONCURRENCY=2

# ---- JWT lifetimes (minutes / days) ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- OVH Object Storage (S3-compatible) — PDFs / artwork files ----
S3_ENABLED=0
S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=kwick-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Email (Celery-sent approval / account emails) ----
EMAIL_HOST=ssl0.ovh.net
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@yourdomain.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Kwick <no-reply@yourdomain.com>

# ---- Web Push (VAPID) — same key pair on both lines below (public key is
# also exposed to the frontend so the browser can create a push subscription) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@yourdomain.com

# ---- Frontend (Next.js, output: standalone) ----
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_BASE_URL=wss://api.yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
