# ============================================================
# Kwick Internal Platform — root environment (docker-compose)
# Copy to .env and fill in real values before deploying.
# Target host: OVH Cloud VPS-1, Ubuntu 22.04, 2 vCores / 4 GB RAM.
# ============================================================

# ---- Domains (placeholders — swap once DNS is ready) ----
FRONTEND_DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com

# ---- Django ----
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# Comma-separated origins allowed to call the API from the browser
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
# Used to build links embedded in emails (e.g. employee set-password link)
FRONTEND_URL=https://yourdomain.com
# Business timezone (overdue/today for EDITH + Django). UAE default.
TIME_ZONE=Asia/Dubai

# ---- PostgreSQL (tuned: shared_buffers ~256MB, max_connections ~50) ----
POSTGRES_DB=kwick
POSTGRES_USER=kwick
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis (maxmemory 256MB, allkeys-lru — Channels layer + Celery broker) ----
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/3

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# concurrency matches 2 vCores
CELERY_WORKER_CONCURRENCY=2

# ---- JWT lifetimes (minutes / days) ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- OVH Object Storage (S3-compatible) — PDFs / artwork files ----
S3_ENABLED=0
S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=kwick-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Used to build absolute media URLs (avatars) from the API host
PUBLIC_API_URL=https://api.yourdomain.com

# ---- Email (Celery-sent approval / forgot-password / account emails) ----
# cPanel mailbox admin@kwick.kreativefolio.com (Secure SSL/TLS):
# Outgoing server kwick.kreativefolio.com · SMTP port 465 · SSL
EMAIL_HOST=kwick.kreativefolio.com
EMAIL_PORT=465
EMAIL_HOST_USER=admin@kwick.kreativefolio.com
# If the password contains $, write $$ so Docker Compose does not strip it.
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Kwick <admin@kwick.kreativefolio.com>

# ---- Web Push (VAPID) — same key pair on both lines below (public key is
# also exposed to the frontend so the browser can create a push subscription) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@kwick.kreativefolio.com

# ---- Password vault (Fernet encryption for stored credentials) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWORD_VAULT_KEY=

# ---- Maintenance mode (lock live site to a developer superadmin) ----
# Comma-separated emails that may still sign in while maintenance is on.
# Create that user, then run: docker compose exec backend python manage.py maintenance on
# MAINTENANCE_MODE is only the initial default before the first toggle.
MAINTENANCE_MODE=0
MAINTENANCE_ALLOW_EMAIL=

NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_BASE_URL=wss://api.yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- EDITH AI (OPTIONAL — removable) ----
# Without a key: keyword CRM answers. With a key: real LLM chat.
# Gemini (free tier): get a key at https://aistudio.google.com/apikey
AI_ENABLED=1
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-flash-latest
# OpenAI alternative:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ElevenLabs TTS for EDITH voice replies (optional — falls back to browser speech)
ELEVENLABS_API_KEY=
# Default: Charlotte (clear British female). Change in ElevenLabs → Voices.
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
